# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=pg_app_dev
POSTGRES_USER=db_user
POSTGRES_PASSWORD=your_database_password_here

BACKEND_PORT=8080

# -----------------------------------------------------------------------------
# Auth0
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant-domain.auth0.com
AUTH0_AUDIENCE=https://api.yourdomain.com

# Auth0 Regular Web App credentials
CLIENT_ID=your_auth0_client_id
CLIENT_SECRET=your_auth0_client_secret

# Auth0 Role IDs
AUTH0_ROLE_ID_MOTHER=rol_xxxxxxxxx
AUTH0_ROLE_ID_CAREGIVER=rol_xxxxxxxxx
AUTH0_ROLE_ID_DOCTOR=rol_xxxxxxxxx

# Auth0 Machine-to-Machine credentials (Management API)
AUTH0_M2M_CLIENT_ID=your_auth0_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_auth0_m2m_client_secret

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
AI_SERVICE_BASE_URL=https://your-ai-service.up.railway.app

# -----------------------------------------------------------------------------
# Cloudflare R2
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_URL=https://cdn.yourdomain.com