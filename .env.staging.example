# =============================================================================
# .env.staging.example — Staging environment template
#
# Copy to .env.staging and fill in the actual values:
#   cp .env.staging.example .env.staging
#
# Never commit .env.staging to git!
# =============================================================================

# Application
APP_ENV=staging
PORT=8080

# PostgreSQL
POSTGRES_USER=nusagizi
POSTGRES_PASSWORD=staging_password_here
POSTGRES_DB=nusagizi_prod
POSTGRES_DB_STAGING=nusagizi_staging

# Auth0 — use a SEPARATE Auth0 application for staging
AUTH0_DOMAIN=your-staging-tenant.auth0.com
AUTH0_AUDIENCE=https://staging.api.nusagizi.com

CLIENT_ID=your_staging_auth0_client_id
CLIENT_SECRET=your_staging_auth0_client_secret

AUTH0_M2M_CLIENT_ID=your_staging_auth0_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_staging_auth0_m2m_client_secret

# Auth0 Role IDs (from staging tenant)
AUTH0_ROLE_ID_MOTHER=rol_xxxxxxxxxxxx
AUTH0_ROLE_ID_CAREGIVER=rol_xxxxxxxxxxxx
AUTH0_ROLE_ID_DOCTOR=rol_xxxxxxxxxxxx

# AI Service
AI_SERVICE_BASE_URL=https://nusagizi-ai-production.up.railway.app

# Cloudflare R2 — staging bucket (must be different from production!)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=nusagizi-staging
R2_PUBLIC_URL=https://cdn-staging.nusagizi.com
