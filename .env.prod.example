# =============================================================================
# .env.prod.example — Template environment untuk PRODUCTION
#
# Salin ke .env.prod dan isi dengan nilai yang sesuai:
#   cp .env.prod.example .env.prod
#
# JANGAN commit .env.prod ke git!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=production
PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL (diisi otomatis oleh docker-compose, bisa di-override di sini)
# -----------------------------------------------------------------------------
POSTGRES_USER=nusagizi
POSTGRES_PASSWORD=your_strong_prod_password_here
POSTGRES_DB=nusagizi_prod

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_strong_minio_password_here

# -----------------------------------------------------------------------------
# Auth0 — gunakan aplikasi Auth0 terpisah untuk production
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.nusagizi.com

CLIENT_ID=your_auth0_client_id
CLIENT_SECRET=your_auth0_client_secret
GRANT_TYPE=client_credentials

AUTH0_M2M_CLIENT_ID=your_auth0_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_auth0_m2m_client_secret

# Auth0 Role IDs
AUTH0_ROLE_ID_MOTHER=rol_xxxxxxxxxxxx
AUTH0_ROLE_ID_CAREGIVER=rol_xxxxxxxxxxxx
AUTH0_ROLE_ID_DOCTOR=rol_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
AI_SERVICE_BASE_URL=https://nusagizi-ai-production.up.railway.app

# -----------------------------------------------------------------------------
# Cloudflare R2 — bucket production
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=nusagizi-prod
R2_PUBLIC_URL=https://cdn.nusagizi.com
