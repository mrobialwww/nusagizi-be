# =============================================================================
# .env.dev.example — Development environment template
#
# Copy to .env.dev and fill in the actual values:
#   cp .env.dev.example .env.dev
#
# Never commit .env.dev to git!
# =============================================================================

# Application
APP_ENV=development
PORT=8080

# PostgreSQL
POSTGRES_USER=nusagizi
POSTGRES_PASSWORD=dev_password_here
POSTGRES_DB=nusagizi_prod
POSTGRES_DB_DEV=nusagizi_dev

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=dev_minio_password_here

# Auth0 — use a SEPARATE Auth0 application for development/staging
AUTH0_DOMAIN=your-dev-tenant.auth0.com
AUTH0_AUDIENCE=https://dev.api.nusagizi.com

CLIENT_ID=your_dev_auth0_client_id
CLIENT_SECRET=your_dev_auth0_client_secret
GRANT_TYPE=client_credentials

AUTH0_M2M_CLIENT_ID=your_dev_auth0_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_dev_auth0_m2m_client_secret

# Auth0 Role IDs (from dev tenant)
AUTH0_ROLE_ID_MOTHER=rol_xxxxxxxxxxxx
AUTH0_ROLE_ID_CAREGIVER=rol_xxxxxxxxxxxx
AUTH0_ROLE_ID_DOCTOR=rol_xxxxxxxxxxxx

# AI Service
AI_SERVICE_BASE_URL=https://nusagizi-ai-production.up.railway.app

# Cloudflare R2 — dev bucket (must be different from production!)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=nusagizi-dev
R2_PUBLIC_URL=https://cdn-dev.nusagizi.com
